# Smart Irrigation Platform Configuration

# Flask Application Secret
SECRET_KEY=smart-irrigation-super-secret-key-2026
JWT_SECRET_KEY=jwt-agriculture-key-2026-production

# Database (SQLite for local, PostgreSQL for production)
# SQLite:
DATABASE_URL=sqlite:///smart_irrigation.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/smart_irrigation

# Server Port
PORT=5000

# Weather API (Open-Meteo free tier by default, no key required)
WEATHER_API_PROVIDER=open-meteo

# Vite Frontend Backend Proxy
VITE_API_BASE_URL=http://localhost:5000/api/v1
